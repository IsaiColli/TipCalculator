<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalculadora.Maui.Views.MainPage"
             Title="Calculador de propinas">
    <Grid
        RowDefinitions="Auto,Auto,Auto"
        ColumnDefinitions="*"
        Padding="24"
        RowSpacing="16">

        <Border
            Grid.Row="0"
            Grid.Column="0">

            <Grid
                RowDefinitions="*,*,*,*"
                ColumnDefinitions="Auto,*,Auto"
                Padding="16"
                RowSpacing="8"
                ColumnSpacing="8">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Importe: "
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    BackgroundColor="WhiteSmoke"/>

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="# de personas: "
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="WhiteSmoke"/>
                <Stepper
                    Grid.Row="1"
                    Grid.Column="2"/>

                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="Center"
                    Spacing="16">
                    <Button
                        Text="8%"
                        WidthRequest="75"/>
                    <Button
                       Text="10%"
                        WidthRequest="75"/>
                    <Button
                       Text="12.5%"
                        WidthRequest="75"/>
                    <Button
                       Text="15%"
                        WidthRequest="75"/>

                </HorizontalStackLayout>

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="% de propina: "
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="3"
                    Grid.Column="1"
                    BackgroundColor="WhiteSmoke"
                    />
                <Stepper
                    Grid.Row="3"
                    Grid.Column="2"/>

            </Grid>
        </Border>

        <HorizontalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="Center"
            Spacing="24">

            <Button
                Text="calcula"/>
            <Button
                Text="limpiar"/>

        </HorizontalStackLayout>

        <Border
            Grid.Row="2"
            Grid.Column="0">

            <Grid
                RowDefinitions="*,*,*,*,*,*"
                ColumnDefinitions="*,Auto"
                Padding="16"
                RowSpacing="8"
                ColumnSpacing="4">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Importe del consumo: "/>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="1500"
                    HorizontalTextAlignment="End"/>

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="importe del consumo por person: "/>
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="500"
                    HorizontalTextAlignment="End"/>

                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="importe de la propina: "/>
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="150"
                    HorizontalTextAlignment="End"/>

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="porpina por persona: "/>
                <Label
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="50"
                    HorizontalTextAlignment="End"/>

                <Label
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="importe total de propina: "/>
                <Label
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="1650"
                    HorizontalTextAlignment="End"/>

                <Label
                    Grid.Row="5"
                    Grid.Column="0"
                    Text="importe con porpina por persona: "/>
                <Label
                    Grid.Row="5"
                    Grid.Column="1"
                    Text="550"
                    HorizontalTextAlignment="End"/>

            </Grid>

        </Border>
    </Grid>

</ContentPage>